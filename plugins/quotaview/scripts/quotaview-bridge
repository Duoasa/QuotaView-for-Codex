#!/bin/zsh

# QuotaView for Codex bridge protocol v1.
# This hook is intentionally fail-open: a bridge error must never block Codex.
set +e
setopt NO_NOMATCH
unsetopt BG_NICE
umask 077

plugin_version="1.0.0-preview.4"
protocol_version="1"
event_schema_version="1"
usage_schema_version="1"
event_name="${1:-}"
plugin_root="${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${0:A:h:h}}}}"
data_root="${PLUGIN_DATA:-${CODEX_PLUGIN_DATA:-${CLAUDE_PLUGIN_DATA:-${plugin_root}/data}}}"
events_root="${data_root}/events"
lock_root="${data_root}/.sequence.lock"
input_file=""
event_temp=""
status_temp=""
bridge_temp=""
usage_temp=""
server_pid=""
lock_acquired="false"
usage_lock_acquired="false"
usage_lock_root="${data_root}/.usage-refresh.lock"
usage_refresh_interval_seconds="${QUOTAVIEW_USAGE_REFRESH_INTERVAL_SECONDS:-300}"
[[ "${usage_refresh_interval_seconds}" == <-> \
    && "${usage_refresh_interval_seconds}" -ge 60 ]] \
    || usage_refresh_interval_seconds=300

cleanup() {
    if [[ -n "${server_pid}" ]]; then
        /bin/kill "${server_pid}" 2>/dev/null
        wait "${server_pid}" 2>/dev/null
        server_pid=""
    fi
    [[ -n "${input_file}" ]] && /bin/rm -f -- "${input_file}"
    [[ -n "${event_temp}" ]] && /bin/rm -f -- "${event_temp}"
    [[ -n "${status_temp}" ]] && /bin/rm -f -- "${status_temp}"
    [[ -n "${bridge_temp}" ]] && /bin/rm -f -- "${bridge_temp}"
    [[ -n "${usage_temp}" ]] && /bin/rm -f -- "${usage_temp}"
    [[ "${lock_acquired}" == "true" && -d "${lock_root}" ]] \
        && /bin/rmdir "${lock_root}" 2>/dev/null
    [[ "${usage_lock_acquired}" == "true" && -d "${usage_lock_root}" ]] \
        && /bin/rmdir "${usage_lock_root}" 2>/dev/null
}
trap cleanup EXIT INT TERM

json_value() {
    /usr/bin/plutil -extract "$1" raw -o - "${input_file}" 2>/dev/null
}

hash_identifier() {
    /usr/bin/printf '%s' "$1" \
        | /usr/bin/shasum -a 256 \
        | /usr/bin/awk '{print $1}'
}

json_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    /usr/bin/printf '%s' "${value}"
}

percent_encode() {
    local raw="$1"
    local encoded=""
    local character
    local numeric
    local old_locale="${LC_ALL:-}"
    export LC_ALL=C
    for character in ${(s::)raw}; do
        case "${character}" in
            [A-Za-z0-9.~_-]) encoded+="${character}" ;;
            *)
                printf -v numeric '%02X' "'${character}"
                encoded+="%${numeric}"
                ;;
        esac
    done
    [[ -n "${old_locale}" ]] && export LC_ALL="${old_locale}" || unset LC_ALL
    /usr/bin/printf '%s' "${encoded}"
}

ensure_bridge() {
    /bin/mkdir -p -- "${events_root}" || return 1
    /bin/chmod 700 "${data_root}" "${events_root}" 2>/dev/null

    local installation_file="${data_root}/.installation-id"
    if [[ ! -s "${installation_file}" ]]; then
        /usr/bin/uuidgen \
            | /usr/bin/tr '[:upper:]' '[:lower:]' \
            > "${installation_file}" || return 1
        /bin/chmod 600 "${installation_file}" 2>/dev/null
    fi
    installation_identifier="$(
        /usr/bin/tr -d '\r\n' < "${installation_file}"
    )"
    if [[ ! "${installation_identifier}" =~ '^[A-Za-z0-9._-]{8,128}$' ]]; then
        /usr/bin/uuidgen \
            | /usr/bin/tr '[:upper:]' '[:lower:]' \
            > "${installation_file}" || return 1
        /bin/chmod 600 "${installation_file}" 2>/dev/null
        installation_identifier="$(
            /usr/bin/tr -d '\r\n' < "${installation_file}"
        )"
    fi
    [[ "${installation_identifier}" =~ '^[A-Za-z0-9._-]{8,128}$' ]] \
        || return 1

    created_at="$(
        /usr/bin/plutil -extract createdAt raw -o - \
            "${data_root}/bridge.json" 2>/dev/null
    )"
    [[ "${created_at}" =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' ]] \
        || created_at="$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)"
    bridge_temp="${data_root}/.bridge.$$.json"
    /usr/bin/printf '%s\n' \
        '{' \
        '  "pluginId": "quotaview",' \
        "  \"pluginVersion\": \"${plugin_version}\"," \
        '  "distributionChannel": "git-marketplace",' \
        "  \"bridgeProtocolVersion\": ${protocol_version}," \
        "  \"eventSchemaVersion\": ${event_schema_version}," \
        "  \"installationIdentifier\": \"${installation_identifier}\"," \
        "  \"createdAt\": \"${created_at}\"," \
        '  "capabilities": ["codex-activity-events", "codex-usage-snapshot"]' \
        '}' > "${bridge_temp}" || return 1
    /bin/mv -f -- "${bridge_temp}" "${data_root}/bridge.json" || return 1
    bridge_temp=""
}

rpc_value() {
    local path="$1"
    local response="$2"
    /usr/bin/printf '%s' "${response}" \
        | /usr/bin/plutil -extract "${path}" raw -o - - 2>/dev/null
}

json_string_or_null() {
    local value="$1"
    if [[ -n "${value}" && "${value}" != "null" ]]; then
        /usr/bin/printf '"%s"' "$(json_escape "${value}")"
    else
        /usr/bin/printf 'null'
    fi
}

refresh_usage_snapshot() {
    ensure_bridge || return 1

    if ! /bin/mkdir "${usage_lock_root}" 2>/dev/null; then
        local lock_modified="$(/usr/bin/stat -f '%m' "${usage_lock_root}" 2>/dev/null)"
        local now_epoch="$(/bin/date +%s)"
        if [[ "${lock_modified}" == <-> \
              && $((now_epoch - lock_modified)) -gt 30 ]]; then
            /bin/rmdir "${usage_lock_root}" 2>/dev/null || return 0
            /bin/mkdir "${usage_lock_root}" 2>/dev/null || return 0
        else
            return 0
        fi
    fi
    usage_lock_acquired="true"

    local usage_path="${data_root}/usage.json"
    if [[ "${QUOTAVIEW_USAGE_REFRESH_FORCE:-0}" != "1" \
          && -f "${usage_path}" ]]; then
        local modified="$(/usr/bin/stat -f '%m' "${usage_path}" 2>/dev/null)"
        local now_epoch="$(/bin/date +%s)"
        if [[ "${modified}" == <-> \
              && $((now_epoch - modified)) \
                  -lt "${usage_refresh_interval_seconds}" ]]; then
            return 0
        fi
    fi

    local codex_executable="${CODEX_EXECUTABLE:-}"
    if [[ -z "${codex_executable}" \
          && -x "/Applications/ChatGPT.app/Contents/Resources/codex" ]]; then
        codex_executable="/Applications/ChatGPT.app/Contents/Resources/codex"
    fi
    [[ -n "${codex_executable}" ]] \
        || codex_executable="$(whence -p codex 2>/dev/null)"
    [[ -n "${codex_executable}" && -f "${codex_executable}" \
        && -x "${codex_executable}" ]] || return 1

    local response=""
    local response_id=""
    local initialized="false"
    local rate_finished="false"
    local usage_finished="false"
    local used_percent=""
    local window_duration=""
    local resets_at=""
    local plan_type=""
    local has_credits=""
    local unlimited=""
    local balance=""
    local reached_type=""
    local spend_control_reached=""
    local lifetime_tokens=""
    local recent_daily_tokens=""
    local recent_daily_date=""

    coproc "${codex_executable}" app-server 2>/dev/null
    server_pid="$!"
    /usr/bin/printf '%s\n' \
        "{\"id\":1,\"method\":\"initialize\",\"params\":{\"clientInfo\":{\"name\":\"quotaview-plugin\",\"title\":\"QuotaView for Codex\",\"version\":\"${plugin_version}\"},\"capabilities\":{}}}" \
        >&p || return 1

    while read -r -t 15 -p response; do
        response_id="$(rpc_value id "${response}")"
        case "${response_id}" in
            1)
                [[ -n "$(rpc_value result "${response}")" ]] || break
                initialized="true"
                /usr/bin/printf '%s\n' \
                    '{"method":"initialized","params":{}}' \
                    '{"id":2,"method":"account/rateLimits/read","params":null}' \
                    '{"id":3,"method":"account/usage/read","params":null}' \
                    >&p || break
                ;;
            2)
                rate_finished="true"
                used_percent="$(rpc_value result.rateLimits.primary.usedPercent "${response}")"
                window_duration="$(rpc_value result.rateLimits.primary.windowDurationMins "${response}")"
                resets_at="$(rpc_value result.rateLimits.primary.resetsAt "${response}")"
                plan_type="$(rpc_value result.rateLimits.planType "${response}")"
                has_credits="$(rpc_value result.rateLimits.credits.hasCredits "${response}")"
                unlimited="$(rpc_value result.rateLimits.credits.unlimited "${response}")"
                balance="$(rpc_value result.rateLimits.credits.balance "${response}")"
                reached_type="$(rpc_value result.rateLimits.rateLimitReachedType "${response}")"
                spend_control_reached="$(rpc_value result.rateLimits.spendControlReached "${response}")"
                ;;
            3)
                usage_finished="true"
                lifetime_tokens="$(rpc_value result.summary.lifetimeTokens "${response}")"
                local daily_count="$(rpc_value result.dailyUsageBuckets "${response}")"
                if [[ "${daily_count}" == <-> && "${daily_count}" -gt 0 ]]; then
                    local latest_index=$((daily_count - 1))
                    recent_daily_tokens="$(rpc_value "result.dailyUsageBuckets.${latest_index}.tokens" "${response}")"
                    recent_daily_date="$(rpc_value "result.dailyUsageBuckets.${latest_index}.startDate" "${response}")"
                fi
                ;;
        esac
        [[ "${rate_finished}" == "true" \
            && "${usage_finished}" == "true" ]] && break
    done

    if [[ -n "${server_pid}" ]]; then
        /bin/kill "${server_pid}" 2>/dev/null
        wait "${server_pid}" 2>/dev/null
        server_pid=""
    fi

    [[ "${initialized}" == "true" \
        && "${used_percent}" == <-> \
        && "${used_percent}" -ge 0 \
        && "${used_percent}" -le 100 ]] || return 1
    [[ "${window_duration}" == <-> ]] || window_duration="null"
    [[ "${resets_at}" == <-> ]] || resets_at="null"
    [[ "${plan_type}" =~ '^[A-Za-z0-9_-]{1,64}$' ]] || plan_type=""
    [[ "${has_credits}" == "true" || "${has_credits}" == "false" ]] \
        || has_credits=""
    [[ "${unlimited}" == "true" || "${unlimited}" == "false" ]] \
        || unlimited=""
    [[ "${balance}" =~ '^-?[0-9]+([.][0-9]+)?$' ]] || balance=""
    [[ "${lifetime_tokens}" == <-> ]] || lifetime_tokens="null"
    if [[ "${recent_daily_tokens}" != <-> \
          || ! "${recent_daily_date}" =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' ]]; then
        recent_daily_tokens="null"
        recent_daily_date=""
    fi

    local credits_json="null"
    if [[ -n "${has_credits}" && -n "${unlimited}" ]]; then
        credits_json="{\"hasCredits\":${has_credits},"
        credits_json+="\"unlimited\":${unlimited},"
        credits_json+="\"balance\":$(json_string_or_null "${balance}")"
        credits_json+="}"
    fi
    local limit_reached="false"
    if [[ -n "${reached_type}" && "${reached_type}" != "null" \
          || "${spend_control_reached}" == "true" ]]; then
        limit_reached="true"
    fi
    local captured_at="$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)"
    usage_temp="${data_root}/.usage.$$.json"
    /usr/bin/printf '%s\n' \
        '{' \
        "  \"bridgeProtocolVersion\": ${protocol_version}," \
        "  \"installationIdentifier\": \"${installation_identifier}\"," \
        "  \"usageSchemaVersion\": ${usage_schema_version}," \
        "  \"capturedAt\": \"${captured_at}\"," \
        '  "source": "codex-app-server",' \
        "  \"planType\": $(json_string_or_null "${plan_type}")," \
        '  "primary": {' \
        "    \"usedPercent\": ${used_percent}," \
        "    \"windowDurationMins\": ${window_duration}," \
        "    \"resetsAt\": ${resets_at}" \
        '  },' \
        "  \"credits\": ${credits_json}," \
        "  \"limitReached\": ${limit_reached}," \
        "  \"lifetimeTokens\": ${lifetime_tokens}," \
        "  \"recentDailyTokens\": ${recent_daily_tokens}," \
        "  \"recentDailyDate\": $(json_string_or_null "${recent_daily_date}")" \
        '}' > "${usage_temp}" || return 1
    /bin/chmod 600 "${usage_temp}" 2>/dev/null
    /bin/mv -f -- "${usage_temp}" "${usage_path}" || return 1
    usage_temp=""
    return 0
}

if [[ "${event_name}" == "--refresh-usage" ]]; then
    refresh_usage_snapshot
    exit 0
fi

if [[ "${event_name}" == "--pair" ]]; then
    ensure_bridge || exit 0
    refresh_usage_snapshot >/dev/null 2>&1
    encoded_path="$(percent_encode "${data_root}")"
    /usr/bin/open "quotaview://pair?protocol=1&plugin=quotaview&pathHint=${encoded_path}" >/dev/null 2>&1
    /usr/bin/printf '%s\n' "QuotaView pairing opened. Confirm the PLUGIN_DATA folder in QuotaView."
    exit 0
fi

if [[ "${event_name}" == "--diagnose" ]]; then
    ensure_bridge || {
        /usr/bin/printf '%s\n' "QuotaView bridge data could not be initialized."
        exit 0
    }
    latest_sequence="$(/bin/cat "${data_root}/.sequence" 2>/dev/null)"
    /usr/bin/printf '%s\n' \
        "QuotaView bridge protocol: ${protocol_version}" \
        "Plugin version: ${plugin_version}" \
        "Latest local event sequence: ${latest_sequence:-none}" \
        "Sanitized usage snapshot: $([[ -f "${data_root}/usage.json" ]] && /usr/bin/printf available || /usr/bin/printf waiting)" \
        "Authentication: managed by official Codex"
    exit 0
fi

case "${event_name}" in
    SessionStart|SessionEnd|UserPromptSubmit|PreToolUse|PostToolUse|Stop) ;;
    *) exit 0 ;;
esac

ensure_bridge || exit 0
input_file="${data_root}/.hook-input.$$.json"
/bin/cat > "${input_file}" || exit 0
[[ -s "${input_file}" ]] || exit 0

session_identifier="$(json_value session_id)"
[[ -n "${session_identifier}" ]] || session_identifier="$(json_value thread_id)"
[[ -n "${session_identifier}" ]] || exit 0
session_hash="$(hash_identifier "${session_identifier}")"
turn_identifier="$(json_value turn_id)"
turn_hash=""
[[ -n "${turn_identifier}" ]] && turn_hash="$(hash_identifier "${turn_identifier}")"

workspace_path="$(json_value cwd)"
workspace_name=""
if [[ -n "${workspace_path}" ]]; then
    workspace_name="${workspace_path:t}"
    workspace_name="$(
        /usr/bin/printf '%s' "${workspace_name}" \
            | /usr/bin/tr -d '[:cntrl:]' \
            | /usr/bin/cut -c 1-80
    )"
fi

tool_name="$(json_value tool_name)"
[[ -n "${tool_name}" ]] || tool_name="$(json_value tool)"
tool_category=""
if [[ "${event_name}" == "PreToolUse" || "${event_name}" == "PostToolUse" ]]; then
    case "${tool_name}" in
        Bash|exec_command|shell|local_shell) tool_category="shell" ;;
        apply_patch|Edit|Write) tool_category="fileEdit" ;;
        Agent|spawn_agent|*subagent*) tool_category="subagent" ;;
        mcp__*|MCP*) tool_category="mcp" ;;
        "") tool_category="unknown" ;;
        *) tool_category="localTool" ;;
    esac
fi

session_source=""
if [[ "${event_name}" == "SessionStart" ]]; then
    session_source="$(json_value source)"
    case "${session_source}" in
        startup|resume|clear|compact) ;;
        *) session_source="startup" ;;
    esac
fi

for _ in {1..30}; do
    if /bin/mkdir "${lock_root}" 2>/dev/null; then
        lock_acquired="true"
        break
    fi
    /bin/sleep 0.05
done
[[ "${lock_acquired}" == "true" ]] || exit 0

sequence_file="${data_root}/.sequence"
latest_sequence="$(/bin/cat "${sequence_file}" 2>/dev/null)"
[[ "${latest_sequence}" == <-> ]] || latest_sequence=0
next_sequence=$((latest_sequence + 1))
/usr/bin/printf '%s\n' "${next_sequence}" > "${sequence_file}" || exit 0
sequence_name="$(/usr/bin/printf '%012d' "${next_sequence}")"
occurred_at="$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)"

event_temp="${events_root}/.${sequence_name}.$$.json"
turn_json="null"
workspace_json="null"
tool_json="null"
source_json="null"
[[ -n "${turn_hash}" ]] && turn_json="\"${turn_hash}\""
[[ -n "${workspace_name}" ]] && workspace_json="\"$(json_escape "${workspace_name}")\""
[[ -n "${tool_category}" ]] && tool_json="\"${tool_category}\""
[[ -n "${session_source}" ]] && source_json="\"${session_source}\""
/usr/bin/printf '%s\n' \
    '{' \
    "  \"bridgeProtocolVersion\": ${protocol_version}," \
    "  \"installationIdentifier\": \"${installation_identifier}\"," \
    "  \"sequence\": ${next_sequence}," \
    '  "activity": {' \
    "    \"schemaVersion\": ${event_schema_version}," \
    "    \"event\": \"${event_name}\"," \
    "    \"sessionHash\": \"${session_hash}\"," \
    "    \"turnHash\": ${turn_json}," \
    "    \"workspaceName\": ${workspace_json}," \
    "    \"toolCategory\": ${tool_json}," \
    "    \"sessionStartSource\": ${source_json}," \
    "    \"occurredAt\": \"${occurred_at}\"" \
    '  }' \
    '}' > "${event_temp}" || exit 0
/bin/mv -f -- "${event_temp}" "${events_root}/${sequence_name}.json" || exit 0
event_temp=""

status_temp="${data_root}/.status.$$.json"
/usr/bin/printf '%s\n' \
    '{' \
    "  \"bridgeProtocolVersion\": ${protocol_version}," \
    "  \"installationIdentifier\": \"${installation_identifier}\"," \
    "  \"latestSequence\": ${next_sequence}," \
    "  \"lastSuccessfulWriteAt\": \"${occurred_at}\"," \
    '  "diagnosticStatus": "ok"' \
    '}' > "${status_temp}" || exit 0
/bin/mv -f -- "${status_temp}" "${data_root}/status.json"
status_temp=""

/bin/rmdir "${lock_root}" 2>/dev/null
lock_acquired="false"

# Keep at most 512 local events. Removal is limited to this plugin's events.
event_count="$(
    /usr/bin/find "${events_root}" -type f -name '[0-9]*.json' -maxdepth 1 \
        | /usr/bin/wc -l \
        | /usr/bin/tr -d ' '
)"
if [[ "${event_count}" == <-> && "${event_count}" -gt 512 ]]; then
    remove_count=$((event_count - 512))
    /usr/bin/find "${events_root}" -type f -name '[0-9]*.json' -maxdepth 1 \
        | /usr/bin/sort \
        | /usr/bin/head -n "${remove_count}" \
        | while IFS= read -r expired_event; do
            /bin/rm -f -- "${expired_event}"
        done
fi

if [[ "${QUOTAVIEW_DISABLE_USAGE_REFRESH:-0}" != "1" ]]; then
    case "${event_name}" in
        SessionStart|Stop) refresh_usage_snapshot >/dev/null 2>&1 ;;
    esac
fi

exit 0
